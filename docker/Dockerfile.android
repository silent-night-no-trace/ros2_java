###############################################################################
# ROS 2 Humble + ros2_java Android AAR builder (arm64-v8a)
# - 国产镜像：apt(tuna) / pip(tuna) / rosdistro(ustc) / ros2 apt(ustc) / android(tuna) / gradle(腾讯)
# - 纯网络拉取源码与第三方，无需 release_archives（离线包可选挂载到 /opt/release_archives）
# - 用本地 checkout 覆盖 vcs 拉到的 ros2_java
# - 复用已验证的 Android 补丁：rosidl JNI 符号去重、Fast-DDS OpenSSL/FileWatch、vendor 离线化
# - 输出：/output -> *.aar / jars / jniLibs / share
###############################################################################
# syntax=docker/dockerfile:1

FROM ros:humble-ros-base-jammy AS builder

ARG USE_CN_MIRROR=1
ARG APT_MIRROR_HOST=mirrors.tuna.tsinghua.edu.cn
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG ROS_APT_MIRROR=https://mirrors.ustc.edu.cn/ros2/ubuntu
ARG ROSDISTRO_INDEX_URL=https://mirrors.ustc.edu.cn/rosdistro/index-v4.yaml

ARG ANDROID_API=31
ARG ANDROID_ABI=arm64-v8a
ARG ANDROID_NDK_VERSION=25.2.9519653
ARG CMDLINE_TOOLS_VERSION=11076708
ARG GRADLE_VERSION=7.6
ARG FASTDDS_TINYXML2_COMMIT=8c8293ba8969a46947606a93ff0cb5a083aab47a
ARG GOOGLE_BENCHMARK_COMMIT=c05843a9f622db08ad59804c190f98879b76beba
ARG FOONATHAN_MEMORY_TAG=vendor-1.4.1
ARG ASIO_TAG=asio-1-22-1

ARG ANDROID_REPO_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/android/repository
ARG GRADLE_DIST_MIRROR=https://mirrors.cloud.tencent.com/gradle

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_SDK_ROOT=/opt/android/sdk
ENV ANDROID_HOME=/opt/android/sdk
ENV ANDROID_NDK=/opt/android/sdk/ndk/${ANDROID_NDK_VERSION}
ENV FASTDDS_TINYXML2_DIR=/opt/thirdparty/tinyxml2
ENV FASTDDS_ASIO_DIR=/opt/thirdparty/asio
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV ROSDISTRO_INDEX_URL=${ROSDISTRO_INDEX_URL}
ENV PATH=/opt/gradle/gradle-${GRADLE_VERSION}/bin:/opt/android/sdk/cmdline-tools/latest/bin:/opt/android/sdk/platform-tools:${PATH}

SHELL ["/bin/bash", "-c"]

# ---- apt 国内镜像 + ROS2 apt 源指向镜像 ----
# 基础镜像 ros:humble-ros-base-jammy 自带 ros2 apt 源（指向 packages.ros.org，
# 国内 apt update 很慢），先把它改写到 USTC 镜像；若基础镜像没有 ros2 源则兜底自建。
RUN set -euo pipefail; \
    if [ "${USE_CN_MIRROR}" = "1" ]; then \
      sed -i "s|http://archive.ubuntu.com/ubuntu|https://${APT_MIRROR_HOST}/ubuntu|g" /etc/apt/sources.list; \
      sed -i "s|http://security.ubuntu.com/ubuntu|https://${APT_MIRROR_HOST}/ubuntu|g" /etc/apt/sources.list; \
      # 用 /etc/apt/sources.list.d/* 而非 *.list：基础镜像可能用 deb822 的 .sources 文件
      sed -i "s|http://packages.ros.org/ros2/ubuntu|${ROS_APT_MIRROR}|g" /etc/apt/sources.list.d/* 2>/dev/null || true; \
      sed -i "s|https://packages.ros.org/ros2/ubuntu|${ROS_APT_MIRROR}|g" /etc/apt/sources.list.d/* 2>/dev/null || true; \
    fi; \
    # 不需要源码包索引：剥离 deb-src 行（.list）和 deb822 的 deb-src 类型（.sources），
    # 既省下载又避免镜像 Sources.gz 同步中报 size mismatch（exit 100）。
    sed -i '/^deb-src /d' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null || true; \
    for f in /etc/apt/sources.list.d/*.sources; do [ -f "$f" ] && sed -i 's/^Types:.*deb-src.*/Types: deb/' "$f" || true; done; \
    if ! grep -rh "ros2/ubuntu" /etc/apt/sources.list.d/* 2>/dev/null | grep -q .; then \
      codename="$(. /etc/os-release; echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")"; \
      arch="$(dpkg --print-architecture)"; \
      if [ ! -f /usr/share/keyrings/ros-archive-keyring.gpg ]; then \
        curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
          | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg; \
      fi; \
      ros_apt_url="${ROS_APT_MIRROR}"; \
      if [ "${USE_CN_MIRROR}" != "1" ]; then ros_apt_url="https://packages.ros.org/ros2/ubuntu"; fi; \
      echo "deb [arch=${arch} signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] ${ros_apt_url} ${codename} main" \
        > /etc/apt/sources.list.d/ros2.list; \
    fi

# ---- 构建依赖 ----
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      wget \
      unzip \
      zip \
      git \
      rsync \
      build-essential \
      cmake \
      ninja-build \
      libasio-dev \
      libtinyxml2-dev \
      openjdk-11-jdk \
      openjdk-17-jdk \
      python3 \
      python3-pip \
      python3-vcstool \
      python3-colcon-common-extensions \
      python3-rosdep \
      python3-lark \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /root/.pip && printf "[global]\nindex-url = %s\n" "${PIP_INDEX_URL}" > /root/.pip/pip.conf
RUN mkdir -p /opt/thirdparty /opt/android /opt/gradle /opt/output

# ---- colcon gradle 扩展 ----
RUN set -euo pipefail; \
    retry_wget() { local out="$1"; shift; local n=0; until [ "$n" -ge 3 ]; do wget -O "$out" "$@" && return 0; n=$((n+1)); sleep 2; done; return 1; }; \
    retry_wget /tmp/colcon-gradle.tar.gz "https://codeload.github.com/colcon/colcon-gradle/tar.gz/refs/heads/main" && \
    pip3 install --no-cache-dir /tmp/colcon-gradle.tar.gz && rm -f /tmp/colcon-gradle.tar.gz && \
    retry_wget /tmp/colcon-ros-gradle.tar.gz "https://codeload.github.com/colcon/colcon-ros-gradle/tar.gz/refs/heads/main" && \
    pip3 install --no-cache-dir --no-deps /tmp/colcon-ros-gradle.tar.gz && rm -f /tmp/colcon-ros-gradle.tar.gz

# ---- TinyXML2 源码（Fast-DDS Android 强制 source 模式）----
RUN set -euo pipefail; \
    retry_wget() { local out="$1"; shift; local n=0; until [ "$n" -ge 3 ]; do wget -O "$out" "$@" && return 0; n=$((n+1)); sleep 2; done; return 1; }; \
    rm -rf /tmp/tinyxml2-src "${FASTDDS_TINYXML2_DIR}"; mkdir -p /tmp/tinyxml2-src "${FASTDDS_TINYXML2_DIR}"; \
    retry_wget /tmp/tinyxml2.tar.gz "https://codeload.github.com/leethomason/tinyxml2/tar.gz/${FASTDDS_TINYXML2_COMMIT}"; \
    tar -xzf /tmp/tinyxml2.tar.gz -C /tmp/tinyxml2-src; \
    TINYXML2_CPP_PATH="$(find /tmp/tinyxml2-src -type f -name tinyxml2.cpp | head -n1)"; \
    [ -n "${TINYXML2_CPP_PATH}" ] || { echo "tinyxml2.cpp not found"; exit 1; }; \
    cp -f "$(dirname "${TINYXML2_CPP_PATH}")/tinyxml2.cpp" "${FASTDDS_TINYXML2_DIR}/"; \
    cp -f "$(dirname "${TINYXML2_CPP_PATH}")/tinyxml2.h" "${FASTDDS_TINYXML2_DIR}/"; \
    rm -rf /tmp/tinyxml2.tar.gz /tmp/tinyxml2-src

# ---- Asio 头文件（Android 工具链不搜 host /usr/include）----
RUN set -euo pipefail; \
    retry_wget() { local out="$1"; shift; local n=0; until [ "$n" -ge 3 ]; do wget -O "$out" "$@" && return 0; n=$((n+1)); sleep 2; done; return 1; }; \
    rm -rf /tmp/asio-src "${FASTDDS_ASIO_DIR}"; mkdir -p /tmp/asio-src "${FASTDDS_ASIO_DIR}"; \
    retry_wget /tmp/asio.tar.gz "https://codeload.github.com/chriskohlhoff/asio/tar.gz/refs/tags/${ASIO_TAG}"; \
    tar -xzf /tmp/asio.tar.gz -C /tmp/asio-src; \
    ASIO_HPP_PATH="$(find /tmp/asio-src -type f -name asio.hpp | head -n1)"; \
    [ -n "${ASIO_HPP_PATH}" ] || { echo "asio.hpp not found"; exit 1; }; \
    cp -a "$(dirname "${ASIO_HPP_PATH}")/." "${FASTDDS_ASIO_DIR}/"; \
    rm -rf /tmp/asio.tar.gz /tmp/asio-src

# ---- Gradle ----
RUN wget -O /tmp/gradle-bin.zip "${GRADLE_DIST_MIRROR}/gradle-${GRADLE_VERSION}-bin.zip" || \
    wget -O /tmp/gradle-bin.zip "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"; \
    unzip -q /tmp/gradle-bin.zip -d /opt/gradle && rm -f /tmp/gradle-bin.zip

# ---- Android SDK/NDK ----
RUN mkdir -p ${ANDROID_SDK_ROOT} && \
    wget -O /tmp/cmdline-tools.zip "${ANDROID_REPO_MIRROR}/commandlinetools-linux-${CMDLINE_TOOLS_VERSION}_latest.zip" || \
    wget -O /tmp/cmdline-tools.zip "https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS_VERSION}_latest.zip"; \
    mkdir -p ${ANDROID_SDK_ROOT}/cmdline-tools && \
    unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_SDK_ROOT}/cmdline-tools && rm -f /tmp/cmdline-tools.zip; \
    if [ -d ${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools ]; then \
      mv ${ANDROID_SDK_ROOT}/cmdline-tools/cmdline-tools ${ANDROID_SDK_ROOT}/cmdline-tools/latest; \
    fi; \
    yes | env JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 sdkmanager --sdk_root=${ANDROID_SDK_ROOT} --licenses && \
    env JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 sdkmanager --sdk_root=${ANDROID_SDK_ROOT} \
      "platform-tools" "platforms;android-${ANDROID_API}" "build-tools;33.0.2" "cmake;3.22.1" "ndk;${ANDROID_NDK_VERSION}"

# ---- 工作区 ----
ENV ROS2_ANDROID_WS=/opt/ros2_android_ws
RUN mkdir -p ${ROS2_ANDROID_WS}/src
COPY docker/fetch_sources.py /usr/local/bin/fetch_sources.py
COPY docker/ros2_java_android_humble.repos ${ROS2_ANDROID_WS}/ros2_java_android_humble.repos
RUN python3 /usr/local/bin/fetch_sources.py --repos ${ROS2_ANDROID_WS}/ros2_java_android_humble.repos --src ${ROS2_ANDROID_WS}/src

# ---- 用本地改过的 ros2_java 覆盖 ----
RUN rm -rf ${ROS2_ANDROID_WS}/src/ros2-java/ros2_java
COPY . ${ROS2_ANDROID_WS}/src/ros2-java/ros2_java

# ---- 打包脚本与 AAR 模板 ----
COPY docker/build_android12_aar.sh /usr/local/bin/build_android12_aar.sh
COPY docker/aar_template/ /opt/aar_template/
RUN chmod +x /usr/local/bin/build_android12_aar.sh

WORKDIR ${ROS2_ANDROID_WS}

# ---- 补丁1：rosidl_generator_java Android JNI 符号去重 ----
# 根因：多套 JNI typesupport 变体导出同名符号，Android 上作为 DT_NEEDED 预加载触发 NULL jclass。
# 1) Android 仅生成 rosidl_typesupport_c 一套 message JNI 库
# 2) message JNI 库不再 link 依赖包 *_JNI_LIBRARIES
RUN python3 - <<'PY'
from pathlib import Path
import re

ws = Path('/opt/ros2_android_ws/src')

get_ts = ws / 'ros2-java/ros2_java/rosidl_generator_java/cmake/rosidl_generator_java_get_typesupports.cmake'
text = get_ts.read_text(encoding='utf-8')
if 'if(ANDROID)' not in text:
    text = text.replace(
        'list(APPEND ${TYPESUPPORT_IMPLS} "rosidl_typesupport_c")\n',
        'list(APPEND ${TYPESUPPORT_IMPLS} "rosidl_typesupport_c")\n\n  if(ANDROID)\n    set(${TYPESUPPORT_IMPLS} "rosidl_typesupport_c")\n  endif()\n',
        1,
    )
get_ts.write_text(text, encoding='utf-8')
if 'if(ANDROID)\n    set(${TYPESUPPORT_IMPLS} "rosidl_typesupport_c")\n  endif()' not in text:
    raise RuntimeError('rosidl_generator_java_get_typesupports.cmake patch failed')

gen = ws / 'ros2-java/ros2_java/rosidl_generator_java/cmake/rosidl_generator_java_generate_interfaces.cmake'
text = gen.read_text(encoding='utf-8')
text2 = re.sub(
    r'\n\s*target_link_libraries\(\$\{_library_name\} \$\{\$\{_pkg_name\}_JNI_LIBRARIES\}\)\s*\n',
    '\n',
    text,
)
gen.write_text(text2, encoding='utf-8')
if 'target_link_libraries(${_library_name} ${${_pkg_name}_JNI_LIBRARIES})' in text2:
    raise RuntimeError('rosidl_generator_java_generate_interfaces.cmake patch failed')
PY

# ---- 补丁2：vendor 离线化 + Fast-DDS Android 适配 ----
RUN set -euo pipefail; \
    retry_wget() { local out="$1"; shift; local n=0; until [ "$n" -ge 3 ]; do wget -O "$out" "$@" && return 0; n=$((n+1)); sleep 2; done; return 1; }; \
    retry_wget /opt/thirdparty/google-benchmark.tar.gz "https://codeload.github.com/google/benchmark/tar.gz/${GOOGLE_BENCHMARK_COMMIT}"; \
    retry_wget /opt/thirdparty/foonathan-memory.tar.gz "https://codeload.github.com/eProsima/memory/tar.gz/${FOONATHAN_MEMORY_TAG}"; \
    python3 - <<'PY'
from pathlib import Path
import re

ws = Path('/opt/ros2_android_ws/src')

gb = ws / 'ament/google_benchmark_vendor/CMakeLists.txt'
text = gb.read_text(encoding='utf-8')
text = text.replace('GIT_REPOSITORY https://github.com/google/benchmark.git', 'URL file:///opt/thirdparty/google-benchmark.tar.gz')
text = text.replace('GIT_TAG c05843a9f622db08ad59804c190f98879b76beba  # v${GOOGLE_BENCHMARK_TARGET_VERSION}\n', '')
text = text.replace('GIT_CONFIG advice.detachedHead=false\n', '')
gb.write_text(text, encoding='utf-8')

fm = ws / 'eProsima/foonathan_memory_vendor/CMakeLists.txt'
text = fm.read_text(encoding='utf-8')
text = text.replace('GIT_REPOSITORY https://github.com/eProsima/memory.git', 'URL file:///opt/thirdparty/foonathan-memory.tar.gz')
text = text.replace('GIT_TAG vendor-1.4.1\n', '')
fm.write_text(text, encoding='utf-8')

fastdds = ws / 'eProsima/Fast-DDS/CMakeLists.txt'
text = fastdds.read_text(encoding='utf-8')
text = re.sub(
    r'if\(SECURITY\)\n\s*find_package\(OpenSSL REQUIRED\)\nelse\(\)\n\s*find_package\(OpenSSL\)\nendif\(\)\n',
    'if(NOT ANDROID)\n    if(SECURITY)\n        find_package(OpenSSL REQUIRED)\n    else()\n        find_package(OpenSSL QUIET)\n    endif()\nelse()\n    set(OPENSSL_FOUND FALSE)\nendif()\n',
    text,
    count=1,
)
text = re.sub(
    r'if\(SECURITY\)\n\s*find_package\(OpenSSL REQUIRED\)\nelseif\(NOT ANDROID\)\n\s*find_package\(OpenSSL QUIET\)\nendif\(\)\n',
    'if(NOT ANDROID)\n    if(SECURITY)\n        find_package(OpenSSL REQUIRED)\n    else()\n        find_package(OpenSSL QUIET)\n    endif()\nelse()\n    set(OPENSSL_FOUND FALSE)\nendif()\n',
    text,
    count=1,
)
text = text.replace(
    'option(NO_TLS "Disables TLS Support" OFF)\n',
    'option(NO_TLS "Disables TLS Support" OFF)\nif(ANDROID)\n    set(SECURITY OFF CACHE BOOL "Activate security" FORCE)\n    set(NO_TLS ON CACHE BOOL "Disables TLS Support" FORCE)\nendif()\n',
    1,
)
if 'set(SECURITY OFF CACHE BOOL "Activate security" FORCE)' not in text:
    raise RuntimeError('Fast-DDS patch failed: SECURITY force-off snippet missing')
if 'if(NOT ANDROID)' not in text:
    raise RuntimeError('Fast-DDS patch failed: ANDROID OpenSSL guard missing')
fastdds.write_text(text, encoding='utf-8')

filewatch = ws / 'eProsima/Fast-DDS/thirdparty/filewatch/FileWatch.hpp'
text = filewatch.read_text(encoding='utf-8')
text = text.replace(
    '                current_time += std::chrono::nanoseconds(result.st_mtim.tv_nsec);\n',
    '                current_time += std::chrono::duration_cast<std::chrono::system_clock::duration>(\n'
    '                    std::chrono::nanoseconds(result.st_mtim.tv_nsec));\n',
    1,
)
text = text.replace(
    '            last_write_time_ += std::chrono::nanoseconds(result.st_mtim.tv_nsec);\n',
    '            last_write_time_ += std::chrono::duration_cast<std::chrono::system_clock::duration>(\n'
    '                std::chrono::nanoseconds(result.st_mtim.tv_nsec));\n',
    1,
)
if text.count('duration_cast<std::chrono::system_clock::duration>') < 2:
    raise RuntimeError('Fast-DDS patch failed: FileWatch duration_cast replacements missing')
filewatch.write_text(text, encoding='utf-8')
PY

# ---- rosdep 解析依赖（humble）----
# rosdep update 会拉取所有发行版（含古老的 fuerte.yaml），国内镜像对 fuerte 偶发
# SSL 超时；但 humble 的缓存会正常生成，fuerte 等失败不影响 rosdep install --rosdistro humble，
# 故 rosdep update 失败不致命。
RUN set -euo pipefail; \
    rosdep init 2>/dev/null || true; \
    if [ -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then \
      sed -i 's|https://raw.githubusercontent.com/ros/rosdistro/master|https://mirrors.ustc.edu.cn/rosdistro|g' /etc/ros/rosdep/sources.list.d/20-default.list; \
    fi; \
    for i in 1 2 3; do rosdep update --rosdistro humble 2>&1 || true; sleep 2; done; \
    apt-get -o Acquire::Retries=5 update && \
    rosdep install \
      --from-paths src \
      --ignore-src \
      --rosdistro humble \
      -y -r \
      -t build -t buildtool -t build_export -t buildtool_export -t exec \
      --skip-keys "ament_tools cyclonedds rcl_logging_log4cxx rcl_logging_spdlog rmw_connextdds rmw_connextdds_common rti_connext_dds_cmake_module rmw_cyclonedds_cpp iceoryx_binding_c"; \
    rm -rf /var/lib/apt/lists/*

# ---- Android 交叉编译 ros2_java ----
RUN source /opt/ros/humble/setup.bash && \
    rm -f /opt/ros/humble/share/ament_index/resource_index/rosidl_generate_idl_interfaces/rosidl_generator_py 2>/dev/null || true && \
    rm -f /opt/ros/humble/share/ament_index/resource_index/rosidl_generate_interfaces/rosidl_generator_py 2>/dev/null || true && \
    rm -f /opt/ros/humble/share/ament_index/resource_index/rosidl_generator_packages/rosidl_generator_py 2>/dev/null || true && \
    export PYTHON3_EXEC="$(which python3)" && \
    export PYTHON3_LIBRARY="$(python3 -c 'import os.path,sysconfig; print(os.path.realpath(os.path.join(sysconfig.get_config_var("LIBPL"), sysconfig.get_config_var("LDLIBRARY"))))')" && \
    export PYTHON3_INCLUDE_DIR="$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("INCLUDEPY"))')" && \
    colcon build \
      --merge-install \
      --packages-up-to rcljava std_msgs std_srvs geometry_msgs nav_msgs sensor_msgs \
      --packages-skip \
        cyclonedds rcl_logging_log4cxx rcl_logging_spdlog rosidl_generator_py \
        rclandroid ros2_talker_android ros2_listener_android \
        rcljava_examples ros2_java_examples \
      --cmake-args \
        -DPYTHON_EXECUTABLE=${PYTHON3_EXEC} \
        -DPYTHON_LIBRARY=${PYTHON3_LIBRARY} \
        -DPYTHON_INCLUDE_DIR=${PYTHON3_INCLUDE_DIR} \
        -DCMAKE_TOOLCHAIN_FILE=${ANDROID_NDK}/build/cmake/android.toolchain.cmake \
        -DANDROID=ON \
        -DANDROID_FUNCTION_LEVEL_LINKING=OFF \
        -DANDROID_NATIVE_API_LEVEL=android-${ANDROID_API} \
        -DANDROID_STL=c++_shared \
        -DANDROID_ABI=${ANDROID_ABI} \
        -DANDROID_NDK=${ANDROID_NDK} \
        -DSECURITY=OFF -DNO_TLS=ON -DSQLITE3_SUPPORT=OFF -DSHM_TRANSPORT_DEFAULT=OFF \
        -DCOMPILE_TOOLS=OFF -DFOONATHAN_MEMORY_FORCE_VENDORED_BUILD=ON \
        -DTHIRDPARTY=ON -DTHIRDPARTY_UPDATE=OFF \
        -DAsio_INCLUDE_DIR=${FASTDDS_ASIO_DIR} \
        -DTINYXML2_SOURCE_DIR=${FASTDDS_TINYXML2_DIR} \
        -DTINYXML2_INCLUDE_DIR=${FASTDDS_TINYXML2_DIR} \
        -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=BOTH \
        -DCOMPILE_EXAMPLES=OFF -DBUILD_TESTING=OFF \
        -DRCL_LOGGING_IMPLEMENTATION=rcl_logging_noop \
        -DCMAKE_FIND_ROOT_PATH="${ROS2_ANDROID_WS}/install"

# ---- 打包 AAR ----
RUN /usr/local/bin/build_android12_aar.sh

FROM scratch AS output
COPY --from=builder /opt/output /output
